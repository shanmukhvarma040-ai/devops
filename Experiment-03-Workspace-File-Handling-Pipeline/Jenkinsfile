pipeline {
    agent any
    stages {
        stage('Create File') {
            steps {
                bat 'echo Hello Jenkins > file1.txt'
            }
        }
        stage('Copy File') {
            steps {
                bat 'copy file1.txt file2.txt'
            }
        }
        stage('Display File') {
            steps {
                bat 'type file2.txt'
            }
        }
    }
}
